# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Price IDs — create products in dashboard, copy price IDs here
STRIPE_PRICE_DIGITAL=price_xxx
STRIPE_PRICE_PAPERBACK_SINGLE=price_xxx
STRIPE_PRICE_PAPERBACK_SET=price_xxx
STRIPE_PRICE_HARDCOVER_SET=price_xxx
STRIPE_PRICE_SUBSCRIPTION_MONTHLY=price_xxx

# Email (get from https://resend.com)
RESEND_API_KEY=re_xxx
OWNER_EMAIL=lydia@example.com
FROM_EMAIL=orders@customlearntoread.com

# Abandoned-order recovery (hourly Vercel Cron at /api/cron/abandoned)
# CRON_SECRET protects the cron endpoint; Vercel sends it automatically as a
# Bearer token. Generate any random string. The promo code is the discount the
# recovery email offers — create a matching promotion code in Stripe.
CRON_SECRET=change-me-to-a-random-string
RECOVERY_PROMO_CODE=COMEBACK10
RECOVERY_DISCOUNT_LABEL=10%

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
