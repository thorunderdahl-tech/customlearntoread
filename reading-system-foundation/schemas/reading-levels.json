{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "id": "reading-levels",
  "version": 1,
  "description": "The educational engine. Each level is defined by a cumulative phonics scope-and-sequence, a cumulative set of high-frequency 'heart words', and sentence/convention constraints. A word is eligible at level N if it is decodable with phonics taught by N, is a heart word introduced by N, or is an allowed personalization/theme token (see personalization.json).",
  "notes": {
    "cumulative": "phonics_new and heart_words_new list only what is INTRODUCED at that level. Eligibility is cumulative: level N allows everything from levels 1..N.",
    "heart_word": "A high-frequency word taught with the regular part decoded and the irregular letter(s) memorized 'by heart'. Many Dolch words are actually decodable and are NOT heart words.",
    "leveling_policy": "Custom levels. Grade bands are approximate. We do NOT brand as Fountas & Pinnell (three-cueing, litigation risk) or claim official Lexile measures (proprietary/licensed)."
  },
  "levels": [
    {
      "level": 1, "label": "Ladybug", "grade_band": "PreK-K",
      "phonics_new": ["short a", "continuous consonants m s f n l r", "stop consonants t p c d g b h", "CVC with short a"],
      "heart_words_new": ["I", "the", "a", "is", "to", "see", "my"],
      "max_sentence_words": 4, "max_words_per_page": 8, "pages": [10, 12],
      "new_decodable_words_per_book": [4, 5], "min_repetition_per_new_word": 3,
      "allowed_structures": ["simple"], "tense": ["present"],
      "conventions": { "capital_and_period": true, "question_mark": false, "exclamation": false, "comma_series": false, "dialogue": false, "contractions": false }
    },
    {
      "level": 2, "label": "Caterpillar", "grade_band": "K",
