# Copy to .env and fill in once apps are approved. DRY_RUN stays true until then.

# When "false", the service makes real API calls. Any other value (or unset) => dry-run.
DRY_RUN=true

# Health/manual-run HTTP server port.
PORT=3000

# node-cron schedule for the in-process scheduler (default: every minute).
CRON_SCHEDULE=* * * * *

# --- Instagram (Meta Graph API) ---
# IG must be a Business/Creator account linked to a Facebook Page.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
IG_GRAPH_VERSION=v21.0

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Postgres (Railway) ---
# Leave empty to use the JSON file store under data/. Set to a Railway
# DATABASE_URL to persist calendar/content/log/tokens in Postgres.
DATABASE_URL=
# Set true to force SSL (needed for Railway's public proxy host).
PGSSL=false

# --- Container/publish status polling ---
POLL_INTERVAL_MS=3000
POLL_MAX_ATTEMPTS=20

# Refresh a token this many seconds before it expires.
TOKEN_REFRESH_SKEW_SECONDS=86400

# --- Shared Studio API ---
# If set, required on every route except /health (X-API-Key or Bearer).
API_KEY=
# Allowed CORS origin for the browser Studio (use the Studio's URL in prod).
CORS_ORIGIN=*

# --- Retry / dead-letter for failed posts ---
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=60000
RETRY_MAX_MS=3600000
